# ==============================================================================
# IntellMeet Server Environment Configuration
# ==============================================================================

# Server Network
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1

# CORS Allowed Origins (Comma separated for multiple origins)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# MongoDB Database Connection
# Example local: mongodb://127.0.0.1:27017/intellimeet
# Example Atlas: mongodb+srv://<user>:<password>@cluster.mongodb.net/intellimeet?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/intellimeet

# JWT Authentication
JWT_SECRET=intellmeet_super_secret_jwt_development_key_change_in_production
JWT_EXPIRES_IN=7d

# AI Services Integration (Optional OpenAI API Key for advanced NLP summaries)
OPENAI_API_KEY=

# Logging Level (error, warn, info, http, debug)
LOG_LEVEL=info
